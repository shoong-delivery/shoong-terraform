# env.sh.example
#
# 이 파일을 env.sh로 복사한 뒤 실제 값을 채워서 사용하세요.
#   cp env.sh.example env.sh
#
# env.sh는 비밀값을 담으므로 git에 커밋되지 않습니다(.gitignore 처리됨).
# init.sh 실행 시 자동으로 source 됩니다.

# 레포들이 위치한 기준 디렉토리
# (미설정 시 scripts의 상위 폴더가 기본값으로 사용됨)
export ROOT='/path/to/shoong-delivery'

# GitOps 레포 접근용 GitHub Personal Access Token
export GITHUB_PAT='ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

# RDS 접속 자격증명 (AWS Secrets Manager에 등록할 값)
export DB_USERNAME='admin'
export DB_PASSWORD='password'
